#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	mkdir -p debian/build/locale/pt_BR/LC_MESSAGES
	msgfmt --check po/pt_BR.po -o debian/build/locale/pt_BR/LC_MESSAGES/inpedf.mo

override_dh_auto_install:
	install -D -m 755 debian/inpedf-launcher debian/inpedf/usr/bin/inpedf
	install -D -m 644 data/inpedf.desktop debian/inpedf/usr/share/applications/br.com.inpedf.InPeDF.desktop

override_dh_auto_test:
	desktop-file-validate data/inpedf.desktop
	glib-compile-schemas --strict --dry-run data
